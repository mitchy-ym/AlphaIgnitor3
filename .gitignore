# ==============================================================================
# AlphaIgnitor3 .gitignore (Zero-based clean specification)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Artifacts & Generated Outputs
# ------------------------------------------------------------------------------
predict/
report/
log/
logs/
cache/
models/
aggs/
scratch/
tmp/
*.log

# ------------------------------------------------------------------------------
# 2. Python Bytecode, Caches & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Testing, Coverage & Linter Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 4. Sensitive Credentials & Local Secrets
# ------------------------------------------------------------------------------
secrets/
*.env
*.env.local
*.env.*.local
!secrets/credentials.env.example

# ------------------------------------------------------------------------------
# 5. Database, Storage & Large Data Caches
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle

# ------------------------------------------------------------------------------
# 6. IDE, Editors & Operating System Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# VS Code
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iml
*.iws

# Editors
*.swp
*.swo
*~
.#*

# ------------------------------------------------------------------------------
# 7. Archives & Compressed Packages
# ------------------------------------------------------------------------------
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z
*.bz2
